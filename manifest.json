{
  "manifest_version": 3,
  "name": "xClick",
  "short_name": "xClick",
  "version": "0.4.4",
  "description": "Customizable animation previews, color themes, keyboard-triggered feedback, and synthesized sounds for X interactions.",
  "homepage_url": "https://github.com/mCapricorn/xClick",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "xClick",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  }
}
