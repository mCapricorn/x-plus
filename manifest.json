{
  "manifest_version": 3,
  "name": "xClick",
  "version": "0.4.1",
  "description": "Interaction effects, keyboard-triggered feedback, and synthesized sound variants for likes, follows, and replies on X.",
  "permissions": ["storage"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_title": "xClick", "default_popup": "popup.html" }
}
